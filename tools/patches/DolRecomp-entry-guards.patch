diff --git a/src/backend/llvm/entry_guard.cpp b/src/backend/llvm/entry_guard.cpp
new file mode 100644
index 0000000..af2eb95
--- /dev/null
+++ b/src/backend/llvm/entry_guard.cpp
@@ -0,0 +1,35 @@
+#include "backend/llvm/entry_guard.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <unordered_set>
+
+namespace dolllvm {
+
+// Read once, shared by every emitting thread.
+bool entryGuardWanted(u32 guest_start) {
+  static std::once_flag once;
+  static bool all = true;
+  static std::unordered_set<u32> listed;
+  std::call_once(once, [] {
+    const char *path = std::getenv("DOLRECOMP_GUARDED_ENTRIES");
+    if (!path || !path[0])
+      return;
+    FILE *file = std::fopen(path, "r");
+    if (!file)
+      return; // unreadable: keep every guard rather than drop them all
+    char line[64];
+    while (std::fgets(line, sizeof line, file)) {
+      char *end = nullptr;
+      unsigned long value = std::strtoul(line, &end, 0);
+      if (end != line)
+        listed.insert(static_cast<u32>(value));
+    }
+    std::fclose(file);
+    all = false;
+  });
+  return all || listed.count(guest_start) != 0;
+}
+
+} // namespace dolllvm
diff --git a/src/backend/llvm/entry_guard.h b/src/backend/llvm/entry_guard.h
new file mode 100644
index 0000000..bda6c55
--- /dev/null
+++ b/src/backend/llvm/entry_guard.h
@@ -0,0 +1,14 @@
+#pragma once
+
+#include "common/types.h"
+
+namespace dolllvm {
+
+// Whether a function's native entry carries the interception query
+// (ppc_native_region_available). Every function does, unless
+// DOLRECOMP_GUARDED_ENTRIES names a file of addresses - then only those do.
+// A host that intercepts a fixed set of functions (its own native SDK
+// implementations) lists them, and every other call is one branch lighter.
+bool entryGuardWanted(u32 guest_start);
+
+} // namespace dolllvm
