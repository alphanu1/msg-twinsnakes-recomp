+// DOLRECOMP_PURE_EXTERNAL=1: the runtime's external_read/external_write
+// never read or change guest registers and never raise a guest exception, so
+// the slow path is a plain call - no state written back before it, no
+// exception test and no state reloaded after. Without this, every load and
+// store in a natively-callable function carried a full write-back and reload
+// on its slow path, and the engine's code grew fivefold (HANDOFF F366).
+static bool pureExternal() {
+  static const bool pure = [] {
+    const char *env = getenv("DOLRECOMP_PURE_EXTERNAL");
+    return env && env[0] && env[0] != '0';
+  }();
+  return pure;
+}
