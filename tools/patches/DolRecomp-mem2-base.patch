@@ -12,6 +13,24 @@ namespace dolllvm {
 
 using namespace llvm;
 
+// WHERE THE SECOND DIRECT-RAM WINDOW STARTS, normalised (bit 30 cleared).
+//
+// The Wii's MEM2 by default. DOLRECOMP_MEM2_BASE moves it: Twin Snakes keeps
+// its engine overlay's data in a second window at 0x7E000000 (0x3E000000
+// normalised), which its host maps as one flat buffer through the same
+// exram/exram_size fields, so the engine's data is read inline rather than
+// through the external-read call.
+static u32 mem2Base() {
+  static u32 base = 0;
+  static bool read = false;
+  if (!read) {
+    const char *env = getenv("DOLRECOMP_MEM2_BASE");
+    base = (env && env[0]) ? (u32)strtoul(env, nullptr, 0) : WII_MEM2_BASE;
+    read = true;
+  }
+  return base;
+}
+
 Value *FunctionEmitter::normalizeAddress(Value *address) {
   return builder_.CreateAnd(address, builder_.getInt32(~0x40000000u));
 }
