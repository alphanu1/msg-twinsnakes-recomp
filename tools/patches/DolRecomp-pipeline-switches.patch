+/* CODE ADDRESSES HELD IN DATA (DOLRECOMP_ENTER_DATA_REFS=1).
+ *
+ * An indirect branch can reach any address the program can compute, and
+ * the addresses a program computes branch targets from are the ones stored
+ * in its data: switch jump tables, function pointers, vtables. Direct
+ * branch targets are entries already; these were not, so a `bctr` into a
+ * switch case left native code at an address with no entry and the
+ * runtime interpreted from there. A runtime without an interpreter cannot,
+ * and making every block an entry was the price of that - most of a
+ * native build's code size and compile time (Twin Snakes, HANDOFF F370).
+ *
+ * Every aligned word of every non-executable section whose value is a code
+ * address becomes an entry. A REL's sections are relocated before this
+ * runs, so its jump tables already hold final addresses. A word of data
+ * that only happens to look like a code address costs one extra entry,
+ * nothing more. The two frontends fill this before emitting and clear it
+ * after. */
+static const u32* data_ref_entries;
+static u32 data_ref_entry_count;
+
+static int enter_data_refs(void) {
+    const char* e = getenv("DOLRECOMP_ENTER_DATA_REFS");
+    return e && e[0] && e[0] != '0';
+}
+
+static int note_data_refs(const u8* data, u32 size, u32** list, u32* count,
+                          u32* capacity) {
+    for (u32 offset = 0; data && offset + 4u <= size; offset += 4u) {
+        if (*count == *capacity) {
+            u32 grown = *capacity ? *capacity * 2u : 4096u;
+            u32* bigger = (u32*)realloc(*list, grown * sizeof(**list));
+            if (!bigger)
+                return 0;
+            *list = bigger;
+            *capacity = grown;
+        }
+        u32 value = read_be32(data + offset);
+        if ((value & 3u) == 0u)
+            (*list)[(*count)++] = value;
+    }
+    return 1;
+}
+
+/* DOLRECOMP_EXTRA_ENTRIES=<file>: more entries, one address per line.
+ * For what another binary enters in this one - a REL entering its DOL's
+ * register save helpers part-way, which the DOL itself never does. A list
+ * the caller derives from the other binary's relocations; addresses that
+ * are not code in the binary being built are ignored like any other. */
+static int note_extra_entries(u32** list, u32* count, u32* capacity) {
+    const char* path = getenv("DOLRECOMP_EXTRA_ENTRIES");
+    if (!path || !path[0])
+        return 1;
+    FILE* file = fopen(path, "r");
+    if (!file) {
+        fprintf(stderr, "error: DOLRECOMP_EXTRA_ENTRIES: cannot open %s\n", path);
+        return 0;
+    }
+    char line[64];
+    while (fgets(line, sizeof line, file)) {
+        char* end = NULL;
+        unsigned long value = strtoul(line, &end, 0);
+        if (end == line)
+            continue;
+        u8 word[4] = {(u8)(value >> 24), (u8)(value >> 16), (u8)(value >> 8),
+                      (u8)value};
+        if (!note_data_refs(word, 4u, list, count, capacity)) {
+            fclose(file);
+            return 0;
+        }
+    }
+    fclose(file);
+    return 1;
+}
