+        const char* ext = getenv("DOLRECOMP_EXTERNAL_RANGES");
+        FILE* ef = (ext && ext[0]) ? fopen(ext, "r") : NULL;
+        if (ext && ext[0] && !ef) {
+            fprintf(stderr, "error: DOLRECOMP_EXTERNAL_RANGES: cannot open %s\n", ext);
+            goto fail;
+        }
+        if (ef) {
+            u32 cap = range_count + 4096u, n = range_count;
+            unsigned long a, b;
+            DolLLVMFunctionRange* all =
+                (DolLLVMFunctionRange*)calloc(cap, sizeof(*all));
+            if (!all) { fclose(ef); goto fail; }
+            memcpy(all, ranges, (size_t)range_count * sizeof(*all));
+            while (fscanf(ef, "%lx %lx", &a, &b) == 2) {
+                if (n == cap) {
+                    DolLLVMFunctionRange* grown = (DolLLVMFunctionRange*)realloc(
+                        all, (size_t)(cap * 2u) * sizeof(*all));
+                    if (!grown) { free(all); fclose(ef); goto fail; }
+                    memset(grown + cap, 0, (size_t)cap * sizeof(*grown));
+                    all = grown;
+                    cap *= 2u;
+                }
+                if (llvm_range_for(ranges, range_count, (u32)a)) continue;
+                all[n].start = (u32)a;
+                all[n].end = (u32)b;
+                ++n;
+            }
+            fclose(ef);
+            job_ranges = all;
+            job_range_count = n;
+            printf("external ranges: %u functions of the other binary callable directly\n",
+                   n - range_count);
+        }
+    }
     u32 emitted_range_count = 0;
