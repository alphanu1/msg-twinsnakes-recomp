+  // EVERY BLOCK ENTERABLE (DOLRECOMP_ENTER_EVERY_BLOCK=1).
+  //
+  // A runtime with no interpreter cannot resume at a block that is not a
+  // region leader: the entry dispatch has no case for it and the cold entry
+  // interprets forward to the next leader through ppc_fallback_instruction.
+  // Twin Snakes' host is built on there being no interpreter, so for it every
+  // block start is a native entry - the C backend's "every address is
+  // labelled" guarantee, at block granularity. The cost is the fragmentation
+  // measured above (5-16% on the titles that did not need it); the gain is
+  // that nothing is ever interpreted.
+  // ENTRIES WHERE A TRAP RETURNS (DOLRECOMP_ENTER_TRAP_POINTS=1).
+  //
+  // The narrower rule, and the one Twin Snakes needs: an instruction that
+  // can trap and be RETURNED TO must be enterable. The SDK switches the FPU
+  // lazily - after a thread switch floating point is off, the thread's next
+  // float instruction takes the FP-unavailable exception, the handler
+  // restores the FPU and rfi's back to that same instruction, mid-block.
+  // Every float instruction's block begins with its availability check, so
+  // those blocks are entries; so are blocks with a paired-single quantised
+  // load or store, whose slow form side-exits at its own address. About 4%
+  // of the engine's instructions, where every-block was all of them.
+  if (const char *traps = getenv("DOLRECOMP_ENTER_TRAP_POINTS")) {
+    if (traps[0] && traps[0] != '0')
+      for (u32 i = 0; i < source_.block_count; i++) {
+        const DolIRBlock &body = source_.blocks[i];
+        for (u32 n = 0; n < body.instruction_count; n++) {
+          const DolIRInstruction &in = body.instructions[n];
+          if (in.op == DOLIR_OP_HELPER_CALL &&
+              (in.aux == DOLIR_HELPER_FP_AVAILABLE ||
+               in.aux == DOLIR_HELPER_PSQ_LOAD ||
+               in.aux == DOLIR_HELPER_PSQ_STORE)) {
+            region_leaders_[i] = true;
+            break;
+          }
+        }
+      }
+  }
+  if (const char *every = getenv("DOLRECOMP_ENTER_EVERY_BLOCK")) {
+    if (every[0] && every[0] != '0')
+      for (u32 i = 0; i < source_.block_count; i++)
+        region_leaders_[i] = true;
+  }
