{
  global:
    staticrecomp_get_module;
    /* The lockstep verifier dlsym's this to install the module's RAM write
       journal; without it the verifier silently disables itself. */
    ppc_set_mem_write_journal;
    /* Ours: the host installs the SDK patch table through this, so a patched
       function's translated body never runs. Hidden by upstream's version
       script, which lists only the two symbols above - so a dlsym for it
       returns NULL and the host silently falls back to translated SDK code,
       which looks like the hook not being called rather than not being
       found. */
    mgs_dispatch_set_patch_hook;
    mgs_dispatch_patched_calls;
    /* The second window's buffer, for the chunks' inlined accessors
       (mgs_cpu.h). Unexported, the fast path simply stays off. */
    mgs_dispatch_set_vmem;
    /* The patch lookup, as a question only, for the native-region guard. */
    mgs_dispatch_set_patch_query;
    /* Whether native code must leave when interrupts are re-enabled. */
    dolrecomp_msr_ee_exit_wanted;
  local:
    *;
};
